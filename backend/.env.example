# --- application -----------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=please-generate-32-random-bytes-here
CORS_ORIGINS=https://admin.example.com

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://soulchat:soulchat@postgres:5432/soulchat
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- telegram --------------------------------------------------------------
BOT_TOKEN=123456:ABC-DEF
BOT_USERNAME=SoulChatBot
FORUM_CHAT_ID=-1001234567890
CHANNEL_ID=-1009876543210
BOT_USE_POLLING=true

# --- policy ----------------------------------------------------------------
SUBSCRIPTION_REQUIRED=true
DEFAULT_CODE_SCHEME=gender
MALE_PREFIX_LETTERS=ABCDEFGHIJKLM
FEMALE_PREFIX_LETTERS=NOPQRSTUVWXYZ
CODE_ZERO_PAD=4
CODE_SEPARATOR=-
CODE_EMOJI=
MAX_TOPICS_PER_USER=3
DELETE_PENDING_HOURS=96

# --- security --------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
FLOOD_THRESHOLD=12
MAX_WARNS=3
AI_RISK_BLOCK_THRESHOLD=0.85

# --- ai --------------------------------------------------------------------
AI_PROVIDER=builtin
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_MODEL=gpt-4o-mini

# --- monitoring ------------------------------------------------------------
SENTRY_DSN=
# --- REST API rate limit (TZ 30) ---
API_RATE_LIMIT_PER_MINUTE=240

# --- Backup targets (TZ 31, optional) ---
# S3_BUCKET=soulchat-backups
# S3_ENDPOINT_URL=
# GDRIVE_ACCESS_TOKEN=
# GDRIVE_REFRESH_TOKEN=
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
